{
  "validation_rules": {
    "indicator-no-name-valid": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "name is optional for Indicator; the Amnesty IOC shape omits it",
      "fixture": "valid/sdo/indicator-no-name.json",
      "expected_behavior": "parses_successfully"
    },
    "amnesty-indicator-bundle-valid": {
      "category": "meta",
      "object_type": "bundle",
      "rule": "Indicators that omit name (the Amnesty IOC feed shape) validate with no missing_property errors",
      "fixture": "valid/sdos/amnesty-indicators.json",
      "expected_behavior": "parses_successfully"
    },
    "indicator-only-valid-from-missing": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "Only required properties that are absent are reported",
      "fixture": "invalid/sdo/indicator-no-valid-from.json",
      "expected_error_substring": "missing required property 'valid_from'",
      "expected_errors": [
        {
          "kind": "missing_property",
          "property": "valid_from"
        }
      ]
    },
    "indicator-pattern-type-enum": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "pattern_type SHOULD come from pattern-type-ov; custom values warn",
      "fixture": "invalid/sdo/indicator-bad-pattern-type.json",
      "expected_behavior": "parses_successfully",
      "expected_warnings": [
        "open_vocab_value_not_suggested"
      ]
    },
    "indicator-spec-version-not-2.1": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "spec_version MUST be 2.1",
      "fixture": "invalid/sdo/indicator-spec-version-2.0.json",
      "expected_error_substring": "must be 2.1"
    },
    "malware-instance-no-name-valid": {
      "category": "sdo",
      "object_type": "malware",
      "rule": "name is optional for a malware instance (is_family false)",
      "fixture": "valid/sdos/malware-instance-no-name.json",
      "expected_behavior": "parses_successfully"
    },
    "malware-family-no-name-invalid": {
      "category": "sdo",
      "object_type": "malware",
      "rule": "name MUST be present for a malware family (is_family true)",
      "fixture": "invalid/sdo/malware-family-no-name.json",
      "expected_error_substring": "missing required property 'name'"
    },
    "malware-types-enum": {
      "category": "sdo",
      "object_type": "malware",
      "rule": "malware_types SHOULD come from malware-type-ov; custom values warn",
      "fixture": "invalid/sdo/malware-bad-malware-types.json",
      "expected_behavior": "parses_successfully",
      "expected_warnings": [
        "open_vocab_value_not_suggested"
      ]
    },
    "ipv4-address-format": {
      "category": "sco",
      "object_type": "ipv4-addr",
      "rule": "value MUST be a valid IPv4 address or CIDR block",
      "fixture": "invalid/sco/ipv4-bad-format.json",
      "expected_error_substring": "IPv4 address must be a valid dotted-decimal format"
    },
    "relationship-uuidv5-warns": {
      "category": "sro",
      "object_type": "relationship",
      "rule": "SRO identifiers SHOULD use UUIDv4; UUIDv5 is accepted with a warning",
      "fixture": "valid/sros/relationship-uuidv5.json",
      "expected_behavior": "parses_successfully",
      "expected_warnings": [
        "identifier_uuid_not_v4"
      ]
    },
    "relationship-uuidv1-invalid": {
      "category": "sro",
      "object_type": "relationship",
      "rule": "SRO identifiers do not support UUID versions other than v4/v5",
      "fixture": "invalid/sro/relationship-uuidv1.json",
      "expected_behavior": "stix_error",
      "expected_error_substring": "STIX does not support UUID versions other than UUIDv4 and UUIDv5",
      "expected_errors": [
        {
          "kind": "invalid_uuid"
        }
      ]
    },
    "bundle-not-empty": {
      "category": "meta",
      "object_type": "bundle",
      "rule": "Bundle MUST contain at least one object",
      "fixture": "invalid/bundle/bundle-empty.json",
      "expected_error_substring": "Bundle must contain at least one object"
    },
    "revoked-sdo-parses": {
      "category": "sdo",
      "object_type": "attack-pattern",
      "rule": "Revoked objects are valid STIX and MUST be parseable; only versioning a revoked object is prohibited (spec 3.3)",
      "fixture": "valid/sdos/attack-pattern-revoked.json",
      "expected_behavior": "parses_successfully"
    },
    "revoked-sdo-timestamps-preserved": {
      "category": "sdo",
      "object_type": "attack-pattern",
      "rule": "Parsing a revoked object MUST NOT alter id/created/modified (parsing is not versioning)",
      "fixture": "valid/sdos/attack-pattern-revoked.json",
      "expected_behavior": "parses_successfully"
    },
    "identity-custom-class-warns": {
      "category": "sdo",
      "object_type": "identity",
      "rule": "identity_class SHOULD come from identity-class-ov; custom values warn",
      "fixture": "valid/sdos/identity-custom-class.json",
      "expected_behavior": "parses_successfully",
      "expected_warnings": [
        "open_vocab_value_not_suggested"
      ]
    },
    "file-md5-warns": {
      "category": "sco",
      "object_type": "file",
      "rule": "SHA-256 SHOULD be used; other algorithms warn",
      "fixture": "valid/scos/file-md5.json",
      "expected_behavior": "parses_successfully",
      "expected_warnings": [
        "hash_not_sha256"
      ]
    },
    "identity-uppercase-extension-warns": {
      "category": "sdo",
      "object_type": "identity",
      "rule": "extensions keys SHOULD be lowercase and reference extension definitions",
      "fixture": "valid/sdos/identity-uppercase-extension.json",
      "expected_behavior": "parses_successfully",
      "expected_warnings": [
        "dictionary_key_not_lowercase",
        "extension_key_not_extension_definition"
      ]
    },
    "network-traffic-missing-ports-warns": {
      "category": "sco",
      "object_type": "network-traffic",
      "rule": "network traffic SHOULD contain src_port and dst_port",
      "fixture": "valid/scos/network-traffic-missing-ports.json",
      "expected_behavior": "parses_successfully",
      "expected_warnings": [
        "network_traffic_missing_port"
      ]
    }
  },
  "custom_properties": {
    "indicator-custom-preserved": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "allow_custom=True preserves custom properties on indicators",
      "fixture": "allow_custom/valid/sdos/indicator-custom.json",
      "allow_custom": true,
      "expected_behavior": "parses_successfully",
      "expected_custom": {
        "x_foo": "custom-value"
      }
    },
    "indicator-custom-rejected": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "Custom properties are rejected without allow_custom=True",
      "fixture": "allow_custom/valid/sdos/indicator-custom.json",
      "allow_custom": false,
      "expected_behavior": "validation_error",
      "expected_error_substring": "x_foo"
    },
    "attack-pattern-custom-preserved": {
      "category": "sdo",
      "object_type": "attack-pattern",
      "rule": "allow_custom=True preserves custom properties on attack-patterns",
      "fixture": "allow_custom/valid/sdos/attack-pattern-custom.json",
      "allow_custom": true,
      "expected_behavior": "parses_successfully",
      "expected_custom": {
        "x_foo": "bar"
      }
    },
    "relationship-custom-preserved": {
      "category": "sro",
      "object_type": "relationship",
      "rule": "allow_custom=True preserves custom properties on relationships",
      "fixture": "allow_custom/valid/sros/relationship-custom.json",
      "allow_custom": true,
      "expected_behavior": "parses_successfully",
      "expected_custom": {
        "x_foo": "custom-value"
      }
    },
    "file-custom-preserved": {
      "category": "sco",
      "object_type": "file",
      "rule": "allow_custom=True preserves custom properties on files",
      "fixture": "allow_custom/valid/scos/file-custom.json",
      "allow_custom": true,
      "expected_behavior": "parses_successfully",
      "expected_custom": {
        "x_foo": "custom-value"
      }
    },
    "indicator-custom-bad-key-rejected": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "Custom property names must match the STIX allowed character set",
      "fixture": "allow_custom/invalid/sdo/indicator-custom-bad-key.json",
      "allow_custom": true,
      "expected_behavior": "validation_error",
      "expected_error_substring": "bad-key"
    },
    "indicator-custom-leading-digit-allowed": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "Custom property names may start with a digit",
      "fixture": "allow_custom/valid/sdos/indicator-custom-leading-digit.json",
      "allow_custom": true,
      "expected_behavior": "parses_successfully",
      "expected_custom": {
        "1custom": "value"
      }
    },
    "indicator-custom-reserved-name-rejected": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "Reserved property names are rejected as custom properties",
      "fixture": "allow_custom/invalid/sdo/indicator-custom-reserved.json",
      "allow_custom": true,
      "expected_behavior": "validation_error",
      "expected_error_substring": "severity"
    },
    "indicator-custom-hex-valid": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "_hex suffix values must be lowercase even-length hex strings",
      "fixture": "allow_custom/valid/sdos/indicator-custom-hex.json",
      "allow_custom": true,
      "expected_behavior": "parses_successfully",
      "expected_custom": {
        "x_hash_hex": "deadbeef"
      }
    },
    "indicator-custom-hex-uppercase-rejected": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "Uppercase _hex suffix values are rejected",
      "fixture": "allow_custom/invalid/sdo/indicator-custom-hex-uppercase.json",
      "allow_custom": true,
      "expected_behavior": "validation_error",
      "expected_error_substring": "x_hash_hex"
    },
    "indicator-custom-bin-valid": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "_bin suffix values must be valid base64 strings",
      "fixture": "allow_custom/valid/sdos/indicator-custom-bin.json",
      "allow_custom": true,
      "expected_behavior": "parses_successfully",
      "expected_custom": {
        "x_payload_bin": "aGVsbG8gd29ybGQ="
      }
    },
    "indicator-custom-bin-bad-base64-rejected": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "Invalid base64 _bin suffix values are rejected",
      "fixture": "allow_custom/invalid/sdo/indicator-custom-bin-bad-base64.json",
      "allow_custom": true,
      "expected_behavior": "validation_error",
      "expected_error_substring": "x_payload_bin"
    },
    "indicator-custom-does-not-disable-required-validation": {
      "category": "sdo",
      "object_type": "indicator",
      "rule": "allow_custom=True does not disable required field validation",
      "fixture": "allow_custom/invalid/sdo/indicator-custom-no-pattern.json",
      "allow_custom": true,
      "expected_behavior": "validation_error",
      "expected_error_substring": "missing required property 'pattern'"
    }
  }
}
